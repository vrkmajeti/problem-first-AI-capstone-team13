# ============================================================
# Cross-Impact Catalyst Briefings — Environment Configuration
# ============================================================
# Copy this file to backend/.env and fill in the values below.
# All keys are optional. See README.md for details on each key
# and links to sign up for free tiers.
#
# Minimum setup for real LLM synthesis:
#   Set either GEMINI_API_KEY or OPENAI_API_KEY.
#
# No keys? The app runs in no-key / mock mode using rules-based
# synthesis. All three replay scenarios still work fully.
# ============================================================


# ------------------------------------------------------------
# LLM Provider Selection
# ------------------------------------------------------------
# Which LLM provider to use: "gemini" (default) or "openai"
# If the selected provider's key is missing, the app falls back
# to the other provider automatically.
LLM_PROVIDER=gemini


# ------------------------------------------------------------
# Google Gemini API Key  (default LLM + embeddings)
# ------------------------------------------------------------
# Used for: event extraction (gemini-2.5-flash),
#           synthesis (gemini-2.5-flash),
#           dedup embeddings (models/embedding-001, 768 dims)
#
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=


# ------------------------------------------------------------
# OpenAI API Key  (alternative LLM + embeddings)
# ------------------------------------------------------------
# Used for: event extraction (gpt-4.1-nano),
#           synthesis (gpt-4o-mini),
#           dedup embeddings (text-embedding-3-small, 1536 dims)
#
# Set LLM_PROVIDER=openai above to activate this path.
# Requires a funded account. All replay scenarios cost < $0.10.
#
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=


# ------------------------------------------------------------
# Finnhub API Key  (live direct company news)
# ------------------------------------------------------------
# Used for: fetching real-time company-specific news articles
#           when scenario_id=live (Live Feeds mode).
# Not required for any of the three replay scenarios.
#
# Free tier: 60 API calls/minute — sufficient for this demo.
# Get a free key at: https://finnhub.io
FINNHUB_API_KEY=


# ------------------------------------------------------------
# Currents API Key  (live cross-impact / geopolitical news)
# ------------------------------------------------------------
# Used for: fetching broad external news in Live Feeds mode
#           with Iteration 3 (cross-impact routing).
# Not required for any of the three replay scenarios.
#
# Free tier available.
# Get a free key at: https://currentsapi.services/en/register
CURRENTS_API_KEY=


# ------------------------------------------------------------
# Arize Phoenix Tracing Configuration
# ------------------------------------------------------------
# Phoenix collects OpenTelemetry traces from LangGraph runs.
# The dashboard is accessible at http://localhost:<PHOENIX_PORT>
# after starting the Phoenix server process.
PHOENIX_PROJECT_NAME=cross-impact-catalysts
PHOENIX_PORT=6006


# ------------------------------------------------------------
# Freshness Filter
# ------------------------------------------------------------
# How many minutes back from "now" to accept articles in live
# mode. Articles older than this window are filtered out.
# Replay scenarios bypass this filter entirely.
FRESHNESS_LOOKBACK_MINUTES=10
