# LLM Configurations
# Set the key for the model you want to use.
# By default, the application will attempt to use Gemini.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# API Provider: "gemini" (default) or "openai"
LLM_PROVIDER=gemini

# News API Keys (optional if using scenario replay)
FINNHUB_API_KEY=your_finnhub_api_key_here
CURRENTS_API_KEY=your_currents_api_key_here

# Phoenix Tracing Configuration
PHOENIX_PROJECT_NAME=cross-impact-catalysts
PHOENIX_PORT=6006
