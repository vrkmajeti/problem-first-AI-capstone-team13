{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Backend Requirements",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/pip",
      "args": ["install", "-r", "backend/requirements.txt"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Install Frontend Dependencies",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Unit Tests",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python",
      "args": ["-m", "unittest", "backend/run_tests.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
